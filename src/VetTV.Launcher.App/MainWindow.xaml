<Window x:Class="VetTV.Launcher.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="#0B0B12" Padding="48">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="24">
      <TextBlock Text="VetTV" FontSize="40" FontWeight="Bold" Foreground="#FF5BD1"/>
      <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#A0A0B8" FontSize="18"/>
    </StackPanel>
    <GridView x:Name="Library" Grid.Row="1" Margin="0,24,0,0" SelectionMode="Single" IsItemClickEnabled="True"
              ItemClick="Library_ItemClick" XYFocusKeyboardNavigation="Enabled" TabFocusNavigation="Once">
      <GridView.ItemTemplate><DataTemplate>
        <Border Width="240" Height="135" Background="#1E1E2E" CornerRadius="10" Padding="14">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="18" TextWrapping="Wrap" MaxLines="3"/>
            <TextBlock Text="{Binding Source}" Foreground="#7FE0FF" FontSize="13" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </DataTemplate></GridView.ItemTemplate>
    </GridView>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,16,0,0">
      <ToggleSwitch x:Name="StartupToggle" Header="Start on sign-in" Foreground="White" Toggled="StartupToggle_Toggled"/>
      <ToggleSwitch x:Name="ShellToggle" Header="Shell mode (Pro)" Foreground="White" Toggled="ShellToggle_Toggled" IsEnabled="False"/>
      <Button x:Name="ProButton" Content="Get Pro" Click="ProButton_Click" VerticalAlignment="Bottom" Visibility="Collapsed"/>
      <Button x:Name="ExitButton" Content="Exit to Desktop" Click="ExitButton_Click" VerticalAlignment="Bottom"/>
    </StackPanel>
  </Grid>
</Window>
