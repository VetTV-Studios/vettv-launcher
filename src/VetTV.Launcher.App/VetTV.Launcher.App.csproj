<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only: build on Windows (VS 2022 17.8+ / .NET 8 SDK). Not part of the Linux sln build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>VetTV.Launcher.App</RootNamespace>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Build flavour: Community (GitHub, default) includes the PlayStation hub; Store excludes it (Store policy 10.13.10).
         Store build: msbuild /p:VetTVEdition=Store -->
    <VetTVEdition Condition="'$(VetTVEdition)' == ''">Community</VetTVEdition>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VetTVEdition)' == 'Community'"><DefineConstants>$(DefineConstants);VETTV_COMMUNITY</DefineConstants></PropertyGroup>
  <ItemGroup Condition="'$(VetTVEdition)' != 'Community'"><Compile Remove="Hub\**" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VetTV.Launcher.Core\VetTV.Launcher.Core.csproj" />
    <!-- Watchdog exe is built next to the app so Winlogon\Shell can point at it. -->
    <ProjectReference Include="..\VetTV.Launcher.Watchdog\VetTV.Launcher.Watchdog.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
